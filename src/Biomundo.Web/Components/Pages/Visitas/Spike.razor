@page "/visitas/spike"
@inject IJSRuntime JS

<PageTitle>Biomundo — Spike GPS</PageTitle>

<h1>Control de vendedores — prueba de ubicación</h1>
<p class="text-muted">
    Página de prueba técnica (no es el módulo final). Objetivo: confirmar que la geolocalización HTML5
    funciona dentro del webview de Microsoft Teams Mobile, antes de construir el resto del módulo.
</p>
<p>
    <span class="badge bg-secondary">Versión del spike: @SpikeVersion</span>
    <span class="badge bg-light text-dark border">Servidor arrancó: @ServerStartedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
</p>

<button class="btn btn-primary" @onclick="ProbarUbicacionAsync" disabled="@_cargando">
    @(_cargando ? "Obteniendo ubicación..." : "Probar ubicación")
</button>
<button class="btn btn-outline-secondary ms-2" @onclick="VerDiagnosticoAsync">
    Ver diagnóstico (sin pedir GPS)
</button>

@if (_diagnostico is not null)
{
    <p class="mt-3"><code>@_diagnostico</code></p>
}

@if (_resultado is not null)
{
    <dl class="row mt-3">
        <dt class="col-sm-3">Latitud</dt><dd class="col-sm-9">@_resultado.Latitude</dd>
        <dt class="col-sm-3">Longitud</dt><dd class="col-sm-9">@_resultado.Longitude</dd>
        <dt class="col-sm-3">Precisión (m)</dt><dd class="col-sm-9">@_resultado.Accuracy</dd>
        <dt class="col-sm-3">Vía</dt><dd class="col-sm-9">@_resultado.Via</dd>
    </dl>
    <p class="text-success">✓ Geolocalización funcionó correctamente en este dispositivo/contexto.</p>
    <div id="mapa-ubicacion" style="height: 300px; border-radius: 8px;"></div>
}

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="anonymous" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="anonymous"></script>
<script src="https://res.cdn.office.net/teams-js/2.40.0/js/MicrosoftTeams.min.js" crossorigin="anonymous"></script>
<script src="js/geo.js"></script>

@code {
    // Subir este número manualmente cada vez que se cambie algo relevante del spike (código o manifiesto).
    // Se ve en pantalla para confirmar, al probar en Teams, que el dispositivo cargó la versión esperada
    // y no una vieja que quedó cacheada.
    private const string SpikeVersion = "v7 (mapa con Leaflet + OpenStreetMap)";

    // Hora en que arrancó este proceso del servidor (UTC). Cambia en cada redeploy/reinicio del contenedor:
    // si el valor no cambió tras un deploy, la app vieja sigue corriendo (no se actualizó).
    private static readonly DateTime ServerStartedAt = DateTime.UtcNow;

    private bool _cargando;
    private string? _error;
    private string? _diagnostico = "(todavía no presionado)";
    private GeoResult? _resultado;
    private bool _debeRenderizarMapa;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El <div id="mapa-ubicacion"> solo existe en el DOM cuando _resultado no es null, así que el
        // mapa se dibuja acá (después del render), no en ProbarUbicacionAsync, donde el div todavía no
        // existe en el momento de invocar JS.
        if (_debeRenderizarMapa && _resultado is not null)
        {
            _debeRenderizarMapa = false;
            await JS.InvokeVoidAsync("biomundoGeo.mostrarMapa", _resultado.Latitude, _resultado.Longitude);
        }
    }

    private async Task VerDiagnosticoAsync()
    {
        try
        {
            _diagnostico = await JS.InvokeAsync<string>("biomundoGeo.diagnostico");
        }
        catch (Exception ex)
        {
            _diagnostico = $"ERROR al invocar diagnostico() vía JS interop: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task ProbarUbicacionAsync()
    {
        _cargando = true;
        _error = null;
        _resultado = null;
        StateHasChanged();

        try
        {
            var json = await JS.InvokeAsync<string>("biomundoGeo.getPosition");
            _resultado = GeoResult.ParseTolerante(json);
            _debeRenderizarMapa = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    // Parseo manual y tolerante en vez de deserialización automática de tipos: en pruebas reales en iOS
    // la forma exacta de "timestamp" varió entre dispositivos (entero, con decimales) y rompía la
    // deserialización automática a un record tipado. Acá se extrae cada campo con el tipo que venga,
    // sin asumir nada, y Timestamp queda como texto (no se usa para cálculos, solo se muestra).
    private sealed record GeoResult(double Latitude, double Longitude, double Accuracy, string Timestamp, string Via)
    {
        public static GeoResult ParseTolerante(string json)
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            return new GeoResult(
                GetDouble(root, "latitude"),
                GetDouble(root, "longitude"),
                GetDouble(root, "accuracy"),
                GetRaw(root, "timestamp"),
                GetRaw(root, "via"));
        }

        private static double GetDouble(System.Text.Json.JsonElement root, string prop) =>
            root.TryGetProperty(prop, out var v) && v.TryGetDouble(out var d) ? d : 0;

        private static string GetRaw(System.Text.Json.JsonElement root, string prop) =>
            root.TryGetProperty(prop, out var v)
                ? (v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString()! : v.GetRawText())
                : "(ausente)";
    }
}
